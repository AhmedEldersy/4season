# --- Database ---
# Local dev default (SQLite, zero setup):
DATABASE_URL=sqlite:///./4season.db
# Production example (Postgres):
# DATABASE_URL=postgresql://user:password@host:5432/foreseason

# --- Auth ---
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# --- Google OAuth ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: {BACKEND_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- URLs ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# --- Image storage ---
# Local disk is used by default (see /uploads). Swap for Cloudinary/S3 in production
# by replacing app/services/storage_service.py.
UPLOAD_DIR=uploads

# --- Business rules ---
CANCELLATION_WINDOW_MINUTES=10
DELIVERY_FEE=25

# --- Admin seed account (used by seed.py) ---
ADMIN_EMAIL=owner@4season.com
ADMIN_PASSWORD=Admin@12345
